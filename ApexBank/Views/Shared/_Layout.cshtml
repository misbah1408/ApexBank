@using ApexBank.Enums;
<!doctype html>
<html>

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<title>Apex Financial System</title>
	<script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-slate-100 min-h-screen">
	<nav class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between">
		@{
			var role = @User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
			var link = role == Role.Admin.ToString()
						? "/Admin/Index" : role == Role.Customer.ToString()
						? "/Customer/Dashboard" : role == Role.Teller.ToString()
						? "/Teller/Dashboard" : role == Role.LoanOfficer.ToString()
						? "/LoanOfficer/Index" : role == Role.Auditor.ToString()
						? "/Auditor/Index" : "/";
			<a class="font-bold text-xl" href=@link>🏦 Apex Financial</a>
		}
		<div>
			@if (User?.Identity?.IsAuthenticated == true)
			{
				<span class="mr-4 text-slate-400">
					@User.Identity.Name ·
					@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
				</span>
				<a class="text-red-400" href="/Account/Logout">Logout</a>
			}
		</div>
	</nav>
	<main class="max-w-7xl mx-auto p-6">
		@if (TempData["Success"] != null)
		{
			<div class="bg-emerald-900/50 border border-emerald-700 p-3 rounded mb-5 alert flex items-center justify-between">
				<span>@TempData["Success"]</span>

				<button type="button" onclick="this.parentElement.remove()"
						class="ml-4 text-emerald-300 hover:text-white text-xl font-bold leading-none">
					&times;
				</button>
			</div>
		}

		@if (TempData["Error"] != null)
		{
			<div class="bg-red-900/50 border border-red-700 p-3 rounded mb-5 alert flex items-center justify-between">
				<span>@TempData["Error"]</span>

				<button type="button" onclick="this.parentElement.remove()"
						class="ml-4 text-red-300 hover:text-white text-xl font-bold leading-none">
					&times;
				</button>
			</div>
		}
		@RenderBody()
	</main>
</body>

</html>