@using ApexBank.Enums
@model IEnumerable<ApexBank.Models.Loan>

<h1 class="text-3xl font-bold mb-6">Loan Officer · Underwriting Queue</h1>
<div id="view-officer" class="role-view space-y-6">
	<div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-lg font-bold flex items-center gap-2">
				<i class="fa-solid fa-scale-balanced text-amber-400"></i> Underwriting Queue (Pending Approvals)
			</h2>
			<span class="bg-amber-500/20 text-amber-400 text-xs px-3 py-1 rounded-full font-semibold">
				@Model.Count() Pending Applications
			</span>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full text-left text-xs">
				<thead class="bg-slate-900 text-slate-400 border-b border-slate-700">
					<tr>
						<th class="p-3">Applicant</th>
						<th class="p-3">Category</th>
						<th class="p-3">Amount</th>
						<th class="p-3">Tenure</th>
						<th class="p-3">Collateral Metrics</th>
						<th class="p-3">Action</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-700/50">
					@foreach (var l in Model)
					{
						var rowClass = l.LoanType == LoanType.Gold
								? "bg-blue-500/20 text-blue-400"
								: l.LoanType == LoanType.Personal
								? "bg-purple-500/20 text-purple-400"
								: "bg-green-500/20 text-green-400";
						<tr>
							<td class="p-3 font-semibold">@l.CustomerProfile.User.Name</td>
							<td class="p-3">
								<span class="px-2 py-0.5 rounded font-semibold @rowClass">@l.LoanType</span>
							</td>
							<td class="p-3 font-bold">₹@l.PrincipalAmount.ToString("N2")</td>
							<td class="p-3 font-bold">@l.TenureMonths months</td>
							<td class="p-3 text-slate-400 max-w-96 text-wrap truncate overflow-hidden">
								@if (l.CollateralDetails == null)
								{
									<span>no details available</span>
								}
								else
								{
									@l.CollateralDetails
								}
							</td>
							<td class="p-3">
								<div class="flex flex-col gap-2">
									@if (@l.FileData.Length != 0)
									{
										<a onclick="downloadDoc(@l.Id)" id="download-btn"
												class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded flex items-center justify-center gap-1.5 font-semibold cursor-pointer">
											<i class="fa-solid fa-wand-magic-sparkles"></i> Download Document
										</a>
									}
									else
									{
										<a onclick="openVerificationModal(@l.Id)"
												class="bg-indigo-500 hover:bg-indigo-500 text-white px-3 py-1.5 rounded flex items-center justify-center gap-1.5 font-semibold disabled cursor-not-allowed ">
											<i class="fa-solid fa-wand-magic-sparkles"></i> No document available
										</a>
									}
									<div class="flex gap-2">
										<form method="post" action="/LoanOfficer/Approve" class="flex gap-1">
											<input type="hidden" name="id" value="@l.Id" />
											<input name="interestRate" value="10" type="number" step="0.01"
												   class="w-16 p-1 bg-slate-900 rounded border border-slate-700 text-center" />
											<button
												class="bg-emerald-600 hover:bg-emerald-500 px-2 py-1 rounded font-semibold">
												Approve
											</button>
										</form>
										<form method="post" action="/LoanOfficer/Reject" class="flex gap-1">
											<input type="hidden" name="id" value="@l.Id" />
											<input name="reason" placeholder="Reason"
												   class="w-20 p-1 bg-slate-900 rounded border border-slate-700" />
											<button class="bg-red-600 hover:bg-red-500 px-2 py-1 rounded font-semibold">
												Reject
											</button>
										</form>
									</div>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>


<script>
	async function downloadDoc(loanId){
				document.getElementById("download-btn").href =
					`/LoanOfficer/DownloadPdf?id=${loanId}`;
	}
</script>